{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "dev-attach",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "start",
        "--port",
        "3100"
      ],
      "port": 3100
    }
  ]
}
